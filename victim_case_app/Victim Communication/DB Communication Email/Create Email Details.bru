meta {
  name: Create Email Details
  type: http
  seq: 1
}

post {
  url: {{EnvUrl}}/api/victims/{{VCAGuidNFA}}/victim-communication/email
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{CIN3-Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  {
      "JourneyType": 4,
      "GovNotifyAuditGuid": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "ToEmailAddress": "test@email.com",
      "GovNotifyStatus": 1,
      "SentAt": "2025-11-25T16:01:41.717Z",
      "Notes": "Test email notes",
      "CreatedBy": "Api Testing"
  }
}

settings {
  encodeUrl: true
}

example {
  name: CD - Create success
  
  request: {
    url: {{EnvUrl}}/api/victims/{{VCAGuid}}/charging-decision
    method: POST
    mode: json
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
      User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
    }
  
    body:json: {
      {
          "ChargingDecision": 1,
          "CreatedBy": "JoeyKhattak"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
      Date: Thu, 19 Dec 2024 15:25:11 GMT
      Server: Kestrel
      Transfer-Encoding: chunked
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
            "isSuccess": true,
            "value": {
                "chargingDecision": 1,
                "dateOfHearing": "0001-01-01",
                "locationOfHearing": null,
                "noFurtherAttempts": false,
                "createdBy": "JoeyKhattak",
                "createdOn": "2024-12-19T15:24:52.9914105+00:00",
                "lastModifiedBy": "JoeyKhattak",
                "lastModifiedOn": "2024-12-19T15:24:52.9914106+00:00",
                "isRemoved": false
            },
            "errorMessage": null,
            "statusCode": 0
        }
      '''
    }
  }
}

example {
  name: CD - Create already created
  
  request: {
    url: {{EnvUrl}}/api/victims/{{VCAGuid}}/charging-decision
    method: POST
    mode: json
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
      User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
    }
  
    body:json: {
      {
          "ChargingDecision": 1,
          "CreatedBy": "JoeyKhattak"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
      Date: Thu, 19 Dec 2024 15:26:13 GMT
      Server: Kestrel
      Transfer-Encoding: chunked
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
            "isSuccess": false,
            "value": null,
            "errorMessage": "Charging Decision record already created",
            "statusCode": 15
        }
      '''
    }
  }
}

