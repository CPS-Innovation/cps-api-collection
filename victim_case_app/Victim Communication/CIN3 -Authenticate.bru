meta {
  name: CIN3 -Authenticate
  type: http
  seq: 11
}

post {
  url: {{EnvUrl}}/api/authenticate
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
  x-functions-key: {{EnvKey}}
}

body:form-urlencoded {
  username: {{CIN3_UserName}}
  password: {{CIN3_Password}}
}

script:post-response {
  const response = res.getBody();
   
  bru.setEnvVar("CIN3-Cookie-Auth", JSON.stringify(response));
   
  console.log('environment variables set:', response);
}

settings {
  encodeUrl: true
}

example {
  name: Authenticate
  
  request: {
    url: {{EnvUrl}}/api/authenticate
    method: POST
    mode: formUrlEncoded
    headers: {
      Content-Type: application/x-www-form-urlencoded
      x-functions-key: {{EnvKey}}
    }
  
    body:form-urlencoded: {
      username: MARIA.ESSEX.CIN3
      password: jZ25P9G4nF5Xb6su
    }
  }
  
  response: {
    headers: {
      Content-Length: 594
      Content-Type: application/json
      Date: Thu, 25 Apr 2024 13:11:42 GMT
      Server: Kestrel
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

