meta {
  name: CPS Contact List
  type: http
  seq: 1
}

get {
  url: {{EnvUrl}}/api/cases/{{CaseId}}/contacts
  body: none
  auth: inherit
}

headers {
  Cms-Auth-Values: {{Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

settings {
  encodeUrl: true
}

example {
  name: Victim Contact - Read 1 contact
  
  request: {
    url: {{EnvUrl}}/api/victims/contact/Guid/e202a1b4-fbab-42d1-9f99-e332b6b2d1aa
    method: GET
    mode: none
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
      User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
      Date: Tue, 19 Nov 2024 15:40:10 GMT
      Server: Kestrel
      Transfer-Encoding: chunked
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
            "isSuccess": true,
            "value": [
                {
                    "name": "David J",
                    "telephone": "6839",
                    "email": "david2@cps.com",
                    "victimCaseInfoGuid": "00000000-0000-0000-0000-000000000000",
                    "contactTypeId": 7,
                    "createdBy": "JK2",
                    "createdOn": "2024-11-19T15:25:39.185244+00:00",
                    "lastModifiedBy": "JK2",
                    "lastModifiedOn": "2024-11-19T15:37:17.127953+00:00",
                    "isRemoved": false
                }
            ],
            "errorMessage": null,
            "statusCode": 0
        }
      '''
    }
  }
}

