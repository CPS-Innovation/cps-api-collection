meta {
  name: NFA - Get
  type: http
  seq: 3
}

get {
  url: {{EnvUrl}}/api/victims/{{VCAGuid}}/no-further-action
  body: none
  auth: inherit
}

headers {
  Cms-Auth-Values: {{Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: NFA - Get No NFA records
  
  request: {
    url: {{EnvUrl}}/api/victims/{{VCAGuid}}/no-further-action
    method: GET
    mode: none
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
      User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
      Date: Thu, 06 Nov 2025 13:13:21 GMT
      Server: 
      Cache-Control: no-store, max-age-0
      Pragma: no-cache
      Transfer-Encoding: chunked
      X-Content-Type-Options: nosniff
      Content-Security-Policy: default-src 'self'
      X-Frame-Options: deny
      X-Permitted-Cross-Domain-Policies: none
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
            "isSuccess": false,
            "value": null,
            "errorMessage": "No Further Action record Not Found",
            "statusCode": 20
        }
      '''
    }
  }
}
