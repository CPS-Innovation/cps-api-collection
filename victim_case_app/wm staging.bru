meta {
  name: wm staging
  type: http
  seq: 1
}

post {
  url: https://fa-wm-app-ddei-staging.azurewebsites.net/api/authenticate
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
  x-functions-key: {{EnvKey}}
}

body:form-urlencoded {
  username: {{usernamel}}
  password: {{password}}
}

script:post-response {
  const response = res.getBody();
   
  bru.setEnvVar("Cookie-Auth", JSON.stringify(response));
   
  console.log('environment variables set:', response);
}

settings {
  encodeUrl: true
  timeout: 0
}
