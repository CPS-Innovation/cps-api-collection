meta {
  name: Case Contact - Update
  type: http
  seq: 2
}

patch {
  url: {{EnvUrl}}/api/victims/{{VCAGuid}}/cps-contacts
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  {
    "ContactName": "All New Name",
      "ContactTelephone": "987654",
      "ContactEmail": "newemail@cps.com",
      "CollarNumber": "NX-02",
      "ContactType" : 4,
      "Address": {
          "AddressLine1": "111",
          "AddressLine2": "122",
          "AddressLine3": "133",
          "AddressLine4": "144",
          "AddressLine5": "155",
          "City": "London",
          "Country": "UK",
          "Postcode": "FGH 987"
      },
    "LastModifiedBy": "maria.essex.cin3"
  }
}

settings {
  encodeUrl: true
}

