meta {
  name: Case Contact - Create
  type: http
  seq: 1
}

post {
  url: {{EnvUrl}}/api/victims/{{VCAGuid}}/cps-contacts
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  {
    "ContactName": "Independent Domestic Violence Adviser",
    "ContactTelephone": "07987654321",
    "ContactEmail": "Test.Test@flo.gov.uk",
    "ContactType": 1,
    "CreatedBy": "",
    "Address": {
      "postcode": "ZZ9 9ZZ",
      "addressLine1": "Nowhere Lane",
      "addressLine2": "321 Middle of Nowhere",
      "country": "United Kingdom",
      "city": "Nowhere"
    }
  }
}

settings {
  encodeUrl: true
}

example {
  name: Case Contact - Create 06sc
  
  request: {
    url: {{EnvUrl}}/api/victims/casecontact/Guid/c6456807-d154-4b10-83eb-9baba2691362
    method: POST
    mode: json
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
      User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
    }
  
    body:json: {
      {
          "ContactName": "Joey K",
          "ContactTelephone": "012345",
          "ContactEmail": "joe@cps.com",
          "CollarNumber": "NX-01",
          "ContactType" : 2,
          "CreatedBy": "JoeyKhattak"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
      Date: Thu, 28 Nov 2024 18:52:30 GMT
