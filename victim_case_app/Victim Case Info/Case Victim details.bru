meta {
  name: Case Victim details
  type: http
  seq: 3
}

get {
  url: {{EnvUrl}}/api/urns/{{cmsURN}}/cases/{{UrnCaseId}}
  body: text
  auth: basic
}

headers {
  Cms-Auth-Values: {{Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

auth:basic {
  username: {{usernamel}}
  password: ChairBankLet58!
}

settings {
  encodeUrl: true
}

example {
  name: Victim Case -Read success
  
  request: {
    url: {{EnvUrl}}/api/victims/urn/45MZ1008323/case/2150188/partyId/501
    method: GET
    mode: none
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
