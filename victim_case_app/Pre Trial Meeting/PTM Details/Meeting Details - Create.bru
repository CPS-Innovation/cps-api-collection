meta {
  name: Meeting Details - Create
  type: http
  seq: 1
}

post {
  url: {{EnvUrl}}/api/victims/{{VCAGuidPTMOffer}}/pre-trial-meetings
  body: json
  auth: oauth2
}

headers {
  Cms-Auth-Values: {{Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: 
  refresh_token_url: 
  client_id: 
  client_secret: 
  scope: 
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}

body:json {
  {
  
    "MeetingDateTime": "2025-08-26T15:46:40.711Z",
    "MeetingMethod": 3,
    "SpecialNeeds": true,
    "NatureOfNeeds": "Wheelchair",
    "MeetingSource": 2,
    "LocationName": "",
    "LocationType": 5,
      "CreatedBy": "YouTested"
  }
}

settings {
  encodeUrl: true
}

example {
  name: Meeting Details - Create invalid method type
  
  request: {
    url: {{EnvUrl}}/api/victims/ptm-details/guid/{{VCAGuid}}
    method: POST
    mode: json
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
      User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
    }
  
    body:json: {
      {
        "CreatedBy": "JoeyD",
        "MeetingDateTime": "2024-12-19T15:00:19.643Z",
        "MeetingMethod": 5,
        "SpecialNeeds": true,
        "NatureOfNeeds": "mobility",
        "MeetingSource": 2,
        "LocationName": "CPS Court House",
        "LocationType": 1
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
      Date: Fri, 13 Dec 2024 17:44:11 GMT
      Server: Kestrel
      Transfer-Encoding: chunked
    }
  
    status: {
      code: OK
      text: 200
    }
  
    body: {
      type: json
      content: '''
        {
            "isSuccess": false,
            "value": null,
            "errorMessage": "Invalid Method Type",
            "statusCode": 15
        }
      '''
    }
  }
}

