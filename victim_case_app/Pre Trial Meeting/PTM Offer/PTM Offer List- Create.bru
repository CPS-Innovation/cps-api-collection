meta {
  name: PTM Offer List- Create
  type: http
  seq: 1
}

post {
  url: {{EnvUrl}}/api/victims/{{VCAGuidPTMOffer}}/pre-trial-meeting-offers
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{Cookie-Auth}}
  x-functions-key: {{EnvKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  {
      "PTMAttempt": 6,
      "MeetingOffered": false,
      "MethodOfOffer": 10,
      "ReasonForNoOffer": "Testing Testing",
      "CreatedBy": "MuraliG"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

