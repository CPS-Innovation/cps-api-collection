meta {
  name: Victim - Create PTM - Not offered with reason (Type 1 to 5 and 99)
  type: http
  seq: 14
}

post {
  url: {{StagingWmUrl}}/api/victims/{{Dcf_victimGuid}}/meeting-offers
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingDcfAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  {
      "MeetingType": 1,
      "OtherTypeDescription": "",
      "MeetingContextGuid": "{{$guid}}",
      "MeetingOffered": false,
      "MeetingRequested": false,
      "MethodOfOffer": 10,
      "DateOfOffer": "1900-01-01",
      "ReasonForNoOffer" : "Api Test Automation",
      "CreatedBy": "apiTestAutomation"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: PTM Offer - Get List 1 item
  
  request: {
    url: {{EnvUrl}}/api/victims/ptmoffer/Guid/f5d89da1-3729-4105-9656-c90bb2e75629
    method: GET
    mode: none
    headers: {
      Cms-Auth-Values: {{Cookie-Auth}}
      x-functions-key: {{EnvKey}}
