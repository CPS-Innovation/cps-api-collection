      Content-Type: application/json
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
      Date: Sat, 30 Nov 2024 17:51:35 GMT
      Server: Kestrel
      Transfer-Encoding: chunked
