meta {
  name: CIN5_Wm_Authenticate _Staging
  type: http
  seq: 8
}

post {
  url: {{StagingWmUrl}}/api/authenticate
  body: formUrlEncoded
  auth: inherit
}

headers {
  accept: application/json
  x-functions-key: {{StagingWmKey}}
}

body:form-urlencoded {
  username: {{DCF_Username}}
  password: {{DCF_Password}}
}

script:post-response {
  const response = res.getBody();
   
  bru.setGlobalEnvVar("StagingDcfAuthValue", JSON.stringify(response));
   
  console.log("environment variables set:", response);
  
  if (response.Token) {
      bru.setGlobalEnvVar("StagingDcfAuthToken", response.Token);
      console.log("StagingDcfAuthToken:", response.Token);
  } else {
      console.log("No Token");
  }
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
