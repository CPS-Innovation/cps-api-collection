meta {
  name: witness_guid
  type: http
  seq: 12
}

get {
  url: {{StagingWmUrl}}/api/victims/urns/{{TwifCaseUrn}}/cases/{{TwifCaseId}}/parties/{{Twif_witnessPersonId}}
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingTwifAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
  Token: {{StagingTwifAuthToken}}
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("Twif_witnessGuid",response.value.victimCaseInfoGuid);
  
  console.log("Twif_witnessGuid:",bru.getGlobalEnvVar("Twif_witnessGuid")); 
  
}

settings {
  encodeUrl: true
  timeout: 0
}
