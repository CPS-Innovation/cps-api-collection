meta {
  name: vicitmContactDetails - Create
  type: http
  seq: 11
}

post {
  url: {{StagingWmUrl}}/api/victims/{{victim1Guid}}/cps-contacts
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingWmCMSAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
  Token: {{StagingWmCMSAuthToken}}
}

body:json {
  {
    "ContactName": "SURENAME Firstname",
    "ContactTelephone": "07147414741",
    "ContactEmail": "Test.Test@flo.gov.uk",
    "ContactType": 4,
    "CreatedBy": "Bruno User",
    "Address": {
      "postcode": "ZZ9 9ZZ",
      "addressLine1": "Nowhere Lane",
      "addressLine2": "321 Middle of Nowhere",
      "country": "United Kingdom",
      "city": "Nowhere"
    }
  }
}

script:post-response {
  const response = res.getBody();
  
  bru.setEnvVar("witness1Guid",response.value.victimCaseInfoGuid)
  
  console.log("witness1Guid:",bru.getEnvVar("witness1Guid")); 
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
