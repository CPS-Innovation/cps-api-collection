meta {
  name: witness_onboard_to_VCA
  type: http
  seq: 7
}

post {
  url: {{StagingWmUrl}}/api/victims/urns/{{DCFCaseUrn}}/cases/{{DCFCaseID}}/parties/{{witnessPersonsId}}
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingWmCMSAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
  Token: {{StagingWmCMSAuthToken}}
}

body:json {
  {
      "Urn": "{{DCFCaseUrn}}",
      "CreatedBy": "E2ETestAutomation",
      "Service": 1,
      "Onboarded": false
  }
}

script:post-response {
  const response = res.getBody();
  
  bru.setEnvVar("witness1Guid",response.value.victimCaseInfoGuid)
  
  console.log("witness1Guid:",bru.getEnvVar("witness1Guid")); 
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
