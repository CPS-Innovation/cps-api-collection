meta {
  name: VicitmCaseInfo
  type: http
  seq: 10
}

get {
  url: {{StagingWmUrl}}/api/victims/urns/{{DCFCaseUrn}}/cases/{{DCFCaseID}}/parties/{{victimPersonId}}
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingWmCMSAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  
  const response = res.getBody();
  
  bru.setEnvVar("victim1Guid",response.value.victimCaseInfoGuid)
  
  console.log("victim1Guid:",bru.getEnvVar("victim1Guid")); 
}

settings {
  encodeUrl: true
  timeout: 0
}
