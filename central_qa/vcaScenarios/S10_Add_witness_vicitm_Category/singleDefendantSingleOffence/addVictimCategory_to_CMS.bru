meta {
  name: addVictimCategory_to_CMS
  type: http
  seq: 10
}

patch {
  url: {{StagingWmUrl}}/api/cases/{{DCFCaseID}}/witnesses/{{victimPersonId}}
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingWmCMSAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  [
  {
    "op": "replace",
    "path": "/types",
    "value": "L,V"
  },
  {
    "op": "add",
    "path": "/justification",
    "value": "Test"
  },
  ]
}

settings {
  encodeUrl: true
  timeout: 0
}
