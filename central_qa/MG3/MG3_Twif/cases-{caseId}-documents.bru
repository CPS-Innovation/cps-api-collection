meta {
  name: /cases/{caseId}/documents
  type: http
  seq: 13
}

get {
  url: {{StagingWmUrl}}/api/cases/{{TwifCaseId}}/documents
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingWmCMSAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  const response = typeof res.getBody() === "string"
      ? JSON.parse(res.getBody())
      : res.getBody();
  
  const mg3 = response.find(doc => doc.subject === "MG3");
  const mg3s = response.find(doc => doc.subject === "MG3s");
  
  // MG3
  bru.setVar("documentId_mg3", mg3 ? mg3.documentId : "");
  bru.setVar("materialId_mg3", mg3 ? mg3.materialId : "");
  
  
  // MG3S
  bru.setVar("documentId_mg3s", mg3s ? mg3s.documentId : "");
  bru.setVar("materialId_mg3s", mg3s ? mg3s.materialId : "");
  
  // Console output
  17
  console.log("documentId_mg3:", mg3 ? mg3.documentId : "");
  18
  console.log("materialId_mg3:", mg3 ? mg3.materialId : "");
  19
   
  20
  console.log("documentId_mg3s:", mg3s ? mg3s.documentId : "");
  21
  console.log("materialId_mg3s:", mg3s ? mg3s.materialId : "");
}

settings {
  encodeUrl: true
  timeout: 0
}
