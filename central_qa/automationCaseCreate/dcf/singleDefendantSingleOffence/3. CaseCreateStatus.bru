meta {
  name: 3. CaseCreateStatus
  type: http
  seq: 2
}

get {
  url: {{CaseCreate_Url}}/api/request/{{DcfCaseCreateRequestId}}
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateDcfAuthValue}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("DCFCaseID",response.caseId);
  console.log("DCFCaseID:",bru.getGlobalEnvVar("DCFCaseID")); 
  
  bru.setGlobalEnvVar("DCFCaseUrn",response.caseUrn);
  console.log("DCFCaseUrn:",bru.getGlobalEnvVar("DCFCaseUrn")); 
}

settings {
  encodeUrl: true
  timeout: 0
}
