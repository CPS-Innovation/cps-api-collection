meta {
  name: allocateProsecutor
  type: http
  seq: 34
}

post {
  url: {{StagingWmUrl}}/api/cases/{{TwifCaseId}}/user-allocation-resources/{{prosecutorId}}?resourceType=Prosecutor&complexity=Basic
  body: formUrlEncoded
  auth: inherit
}

params:query {
  resourceType: Prosecutor
  complexity: Basic
}

headers {
  Cms-Auth-Values: {{StagingGetAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
  Content-Type: application/x-www-form-urlencoded
}

settings {
  encodeUrl: true
  timeout: 0
}
