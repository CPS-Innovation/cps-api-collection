meta {
  name: Red case - Priority PCD Review
  type: http
  seq: 31
}

get {
  url: {{StagingWmUrl}}/api/cases/{{TwifCaseId}}/tasks
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingGetAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  // Parse the JSON response
  let response = res.getBody();
   
  // Find the item with the desired type
  let targetItem = response.find(item => item.type === "28 day PCD Review");
   
  if (targetItem) {
      // Log the ID to the console
      console.log("ID for '28 day PCD Review':", targetItem.id);
   
      // Optionally store it in an environment variable
      bru.setGlobalEnvVar("28_day_PCD_Review", targetItem.id);
  } else {
      console.log("Type '28 day PCD Review' not found.");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
