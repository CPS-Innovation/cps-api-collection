meta {
  name: 3. CaseCreateStatus
  type: http
  seq: 1
}

get {
  url: {{CaseCreate_Url}}/api/request/{{TwifCaseCreateRequestId}}
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateTwifAuthValue}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("GetCaseId",response.caseId);
  // console.log("GetCaseId:",bru.getGlobalEnvVar("GetCaseId")); 
  
  bru.setGlobalEnvVar("GetUrn",response.caseUrn);
  // console.log("GetUrn:",bru.getGlobalEnvVar("GetUrn")); 
}

settings {
  encodeUrl: true
  timeout: 0
}
