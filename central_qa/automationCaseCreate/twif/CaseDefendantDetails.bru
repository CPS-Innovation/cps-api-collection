meta {
  name: CaseDefendantDetails
  type: http
  seq: 16
}

get {
  url: {{StagingWmUrl}}/api/cases/{{TwifCaseId}}
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingGetAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  const response = res.getBody();
  
  
  const defId = response.defendants.find(
    listOrder => listOrder.listOrder ===1)?.id;
  
  bru.setGlobalEnvVar("TwifDefendantPersonId",defId);
  
  // console.log("TwifdefendantPersonId:",bru.setGlobalEnvVar("TwifDefendantPersonId",defId)); 
  
  
  
  // console.log("TwifdefendantPersonId:",bru.setGlobalEnvVar("TwifDefendantPersonId", defId)); 
  
  // bru.setGlobalEnvVar("TwifDefendantPersonId",response.defendants[0].id);
  
  // console.log("TwifdefendantPersonId:",bru.getGlobalEnvVar("TwifdefendantPersonId")); 
  
}

settings {
  encodeUrl: true
  timeout: 0
}
