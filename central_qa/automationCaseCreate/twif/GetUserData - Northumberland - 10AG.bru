meta {
  name: GetUserData - Northumberland - 10AG
  type: http
  seq: 20
}

get {
  url: {{StagingWmUrl}}/api/user-data
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingGetAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  // Parse the JSON response
  let response = res.getBody();
  
  bru.setGlobalEnvVar("userId", response.userId);
  bru.setGlobalEnvVar("userSurename", response.userSurname);
  
  const unitId = res.body.allocatedUnits.find(
    unit => unit.unit === "Northumberland")?.unitId;
  
  bru.setGlobalEnvVar("unitId", unitId);
  
  const areaId = res.body.allocatedUnits.find(
    unit => unit.area === "Northumbria")?.areaId;
  
  bru.setGlobalEnvVar("areaId", areaId);
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
