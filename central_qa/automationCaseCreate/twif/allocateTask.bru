meta {
  name: allocateTask
  type: http
  seq: 23
}

patch {
  url: {{StagingWmUrl}}/api/tasks/allocated-to
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingGetAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  partyId: {{twifPartyId}}
  taskIds: {{Twif_pcd_task_id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
