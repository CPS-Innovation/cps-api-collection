meta {
  name: CJ05
  type: http
  seq: 5
}

post {
  url: {{CIN5_baseUrl}}/inbound-json
  body: json
  auth: inherit
}

body:json {
  {
    "CaseStatus": {
      "CaseId": "{{DCFCaseID}}",
      "InformationSubmitted": {      
        "Reason": "Provide Charging Decision",
        "Certification": null,
        "InformationProvided": null,
        "FactualSummary": null,
        "CITP": null
      },
      "StatusChanged": null,
      "CaseContacts": null,
      "ItemId": null,
      "PTIURN": {
        "Force": "00",
        "Unit": "00",
        "Number": "00000",
        "Year": "00",
        "Split": null
      }
    }
  }
}

script:pre-request {
  function generateFiveDigitNumber() {
      return Math.floor(10000 + Math.random() * 90000);
  }
  
  function generateSevenDigitNumber() {
      return Math.floor(1000000 + Math.random() * 9000000);
  }
  
  
  
  function generateUppercaseAlphaNumeric(length) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let result = '';
      for (let i = 0; i < length; i++) {
          result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return result;
  }
  
  
  let cj05 = generateUppercaseAlphaNumeric(12);
  // let ans11 = generateElevenDigitNumber();
  
  bru.setGlobalEnvVar("dcfCJ05ItemId", cj05);
  
  // bru.setGlobalEnvVar("ansElevendigit", ans11);
  
  console.log("dcfCJ05ItemId:", cj05);
  
  // console.log("ansElevendigit:", ans11);
  
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
