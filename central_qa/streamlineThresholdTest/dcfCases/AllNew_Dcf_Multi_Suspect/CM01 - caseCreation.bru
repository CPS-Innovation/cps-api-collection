      "AssociatedCases": null,
      "ItemId": "MG00001"
      }
  }
}

script:pre-request {
  function generateFiveDigitNumber() {
      return Math.floor(10000 + Math.random() * 90000);}
  
  function generateSevenDigitNumber() {
      return Math.floor(1000000 + Math.random() * 9000000);}
  
  function generateElevenDigitNumber() {
      return Math.floor(10000000000 + Math.random() * 90000000000);}
  
  
  function generateUppercaseAlphaNumeric(length) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let result = '';
      for (let i = 0; i < length; i++) {
          result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return result;
  }
  
  const moment = require("moment");
  const now = moment().format("YYYY-MM-DD");
  bru.setGlobalEnvVar("todayDate", now);
  
  
  let greenCase = "G"
  let redCase = "R"
  
  let force = "62";
  let unit = "AC";
  let year = "26";
  
  let toplevel  = "A";
  let secondlevel = "62";
  let thirdlevel = "AC";
  let bottomlevel = "00";
  
  bru.setGlobalEnvVar("DcfGreenCase", greenCase);
  bru.setGlobalEnvVar("DcffRedCase", redCase);
  
  bru.setGlobalEnvVar("DcfForce", force);
  bru.setGlobalEnvVar("DcfUnit", unit);
  bru.setGlobalEnvVar("DcfYear", year);
  bru.setGlobalEnvVar("DcfToplevel", toplevel);
  bru.setGlobalEnvVar("DcfSecondlevel", secondlevel);
  bru.setGlobalEnvVar("DcfThirdlevel", thirdlevel);
  bru.setGlobalEnvVar("DcfBottomlevel", bottomlevel);
  
  
  let ptiURN = generateFiveDigitNumber();
  let cm01 = generateUppercaseAlphaNumeric(12);
  
  let defPer1 = generateUppercaseAlphaNumeric(12);
  let defPer2 = generateUppercaseAlphaNumeric(12);
  let defPer3 = generateUppercaseAlphaNumeric(12);
  let defPer4 = generateUppercaseAlphaNumeric(12);
  let defPer5 = generateUppercaseAlphaNumeric(12);
  
  let caseOff1 = generateUppercaseAlphaNumeric(12);
  let caseOff2 = generateUppercaseAlphaNumeric(12);
  let caseOff3 = generateUppercaseAlphaNumeric(12);
  
  let asnNumber = generateElevenDigitNumber();
  
  let soliciRef = generateUppercaseAlphaNumeric(12);
  let SerShoNo = generateUppercaseAlphaNumeric(10);
  let SerPerId = generateUppercaseAlphaNumeric(10);
  let ConsShoNo = generateFiveDigitNumber(5);
  let ConsPerId = generateUppercaseAlphaNumeric(10);
  let CourtOrderId = generateUppercaseAlphaNumeric(5);
  let CourtOrderId2 = generateUppercaseAlphaNumeric(5);
  let wtRef = generateUppercaseAlphaNumeric(12);
  let victimRef = generateUppercaseAlphaNumeric(12);
  
  
  bru.setGlobalEnvVar("DCFCM01itemId", cm01);
  bru.setGlobalEnvVar("DCFPtiUrnNumber", ptiURN);
  
  bru.setGlobalEnvVar("DefPersonId1", defPer1);
  bru.setGlobalEnvVar("DefPersonId2", defPer2);
  bru.setGlobalEnvVar("DefPersonId3", defPer3);
  bru.setGlobalEnvVar("DefPersonId4", defPer4);
  bru.setGlobalEnvVar("DefPersonId5", defPer5);
  
  bru.setGlobalEnvVar("CaseOffenceId1", caseOff1);
  bru.setGlobalEnvVar("CaseOffenceId2", caseOff2);
  bru.setGlobalEnvVar("CaseOffenceId3", caseOff3);
  
  bru.setGlobalEnvVar("Solicitor", soliciRef);
  
  bru.setGlobalEnvVar("ASNNumber", asnNumber);
  
  
  bru.setGlobalEnvVar("SergeantShoulderNo", SerShoNo);
  bru.setGlobalEnvVar("SergeantPersonId", SerPerId);
  bru.setGlobalEnvVar("ConstableShoulderNo", "PC"+ConsShoNo);
  bru.setGlobalEnvVar("ConstablePersonId", ConsPerId);
  bru.setGlobalEnvVar("CourtOrderId", CourtOrderId);
  bru.setGlobalEnvVar("CourtOrderId2", CourtOrderId);
  bru.setGlobalEnvVar("WitnessRef_1", wtRef);
  bru.setGlobalEnvVar("VictimRef_1", victimRef);
  
  console.log("DCFCM01itemId:", cm01);
  console.log("DCFPtiUrnNumber:", ptiURN);
  
  console.log("ASNNumber:", asnNumber);
  console.log("ConstableShoulderNo:", "PC"+ConsShoNo);
  
  console.log("WitnessRef_1:", wtRef);
  console.log("VictimRef_1:", victimRef);
  
  
  
  
  
  
}

script:post-response {
  let responseData = res.getBody();
  if (responseData.caseId) {
      bru.setGlobalEnvVar("DCFCaseID", responseData.caseId);
      console.log("DCFCaseID:", responseData.caseId);
  } else {
      console.log("No Case Id");
  }
  
  if (responseData.urn) {
      bru.setGlobalEnvVar("DCFCaseUrn", responseData.urn);
      console.log("DCFCaseUrn:", responseData.urn);
  
  } 
  else {
      console.log("No URN");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
