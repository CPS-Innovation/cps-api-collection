meta {
  name: TWIF_CM01_casenumber
  type: http
  seq: 5
}

get {
  url: {{CIN3_CaseCreateUrl}}/api/request/{{TwifCaseRequestId}}
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateAuthValue}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  const response = res.getBody();
  
  bru.setEnvVar("TwifCaseId",response.caseId);
  console.log("TwifCaseId:",bru.getEnvVar("TwifCaseId")); 
  
  bru.setEnvVar("TwifCaseUrn",response.caseUrn);
  console.log("TwifCaseUrn:",bru.getEnvVar("TwifCaseUrn")); 
}

settings {
  encodeUrl: true
  timeout: 0
}
