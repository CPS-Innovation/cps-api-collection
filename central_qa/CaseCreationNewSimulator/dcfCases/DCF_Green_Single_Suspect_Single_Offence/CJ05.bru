meta {
  name: CJ05
  type: http
  seq: 8
}

post {
  url: {{CaseCreate_Url}}/api/dcf/cj05
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateDcfAuthValue}}
}

body:json {
  {
    "ItemId": "{{dcfCJ05ItemId}}",
    "PTIURN": {
      "Force": "{{DcfForce}}",
      "Unit": "{{DcfUnit}}",
      "Number": "{{DCFPtiUrnNumber}}",
      "Year": "{{DcfYear}}"
    },
    "InformationSubmitted": {
      "Reason": "Provide EA",
      "Certification": [
        {
          "CertificationType": "Lines of Enquiry",
          "CertifierComments": "I certify that, in accordance with the CPIA Code of Practice, all reasonable\n\t\t\t\tlines of enquiry have been considered, including those which may point away\n\t\t\t\tfrom the suspect or assist the defence. The CM01 Early Advice request sets\n\t\t\t\tout the enquiries completed, those outstanding, and the rationale for any\n\t\t\t\tlines of enquiry not pursued.",
          "WhenCertified": "2026-02-02T09:00:00+00:00",
          "CertifierName": "#SWP99006 RAMSEY, BARBARA"
        }
      ]
    }
  }
}

script:pre-request {
  function generateFiveDigitNumber() {
      return Math.floor(10000 + Math.random() * 90000);
  }
  
  function generateSevenDigitNumber() {
      return Math.floor(1000000 + Math.random() * 9000000);
  }
  
  
  
  function generateUppercaseAlphaNumeric(length) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let result = '';
      for (let i = 0; i < length; i++) {
          result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return result;
  }
  
  
  let cj05 = generateUppercaseAlphaNumeric(12);
  // let ans11 = generateElevenDigitNumber();
  
  bru.setGlobalEnvVar("dcfCJ05ItemId", cj05);
  
  // bru.setGlobalEnvVar("ansElevendigit", ans11);
  
  console.log("dcfCJ05ItemId:", cj05);
  
  // console.log("ansElevendigit:", ans11);
  
  
  
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("DcfCaseCj05RequestId",response.requestId);
}

settings {
  encodeUrl: true
  timeout: 0
}
