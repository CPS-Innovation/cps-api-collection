meta {
  name: CIN5_CaseCreate_Authentication
  type: http
  seq: 1
}

post {
  url: {{CaseCreate_AuthUrl}}/api/authenticate
  body: formUrlEncoded
  auth: inherit
}

headers {
  accept: application/json
  x-functions-key: {{CIN3_CaseCreate_XfunKey}}
}

body:form-urlencoded {
  username: {{CIN3_Username}}
  password: {{CIN3_Password}}
}

script:post-response {
  const response = res.getBody();
   
  bru.setEnvVar("CaseCreateAuthValue", JSON.stringify(response));
   
  console.log("environment variables set:", response);
  
  if (response.Token) {
      bru.setGlobalEnvVar("CaseCreateAuthValueToken", response.Token);
      console.log("CaseCreateAuthValueToken:", response.Token);
  } else {
      console.log("No Token");
  }
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
