meta {
  name: S1-CaseId
  type: http
  seq: 8
}

get {
  url: {{StagingWmUrl}}/api/cases/{{TwifCaseId}}
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingWmCMSAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  const response = res.getBody();
  bru.setEnvVar("defendantPersonId",response.defendants[0].id);
  // bru.setEnvVar("defendantPersonId",response.filter(w => w.defendants[0]).id);
  console.log("defendantPersonId:",bru.getEnvVar("defendantPersonId")); 
  
  
  // const response = res.getBody();
  // // Ensure that there's at least one defendant and access the witnessId of the first defendant
  // const defendant = response.defendants && response.defendants.length > 0 ? response.defendants[0] : null;
  // if (defendant) {
  //   bru.setEnvVar("defendantPersonId", defendant.id);
  //   console.log("defendantPersonId:", bru.getEnvVar("defendantPersonId"));
  // } else {
  //   console.log("No defendants found in the response.");
  // }
}

settings {
  encodeUrl: true
  timeout: 0
}
