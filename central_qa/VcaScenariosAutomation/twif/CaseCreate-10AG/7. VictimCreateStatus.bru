meta {
  name: 7. VictimCreateStatus
  type: http
  seq: 7
}

get {
  url: {{CaseCreate_Url}}/api/request/{{TwifVictimCreateReqId}}
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateTwifAuthValue}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("TwifCaseId",response.caseId);
  console.log("TwifCaseId:",bru.getGlobalEnvVar("TwifCaseId")); 
  
  bru.setGlobalEnvVar("TwifCaseUrn",response.caseUrn);
  console.log("TwifCaseUrn:",bru.getGlobalEnvVar("TwifCaseUrn")); 
}

settings {
  encodeUrl: true
  timeout: 0
}
