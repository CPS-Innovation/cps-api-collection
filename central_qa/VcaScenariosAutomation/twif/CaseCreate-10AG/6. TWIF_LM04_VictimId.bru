meta {
  name: 6. TWIF_LM04_VictimId
  type: http
  seq: 6
}

post {
  url: {{CaseCreate_Url}}/api/twif/lm04
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateTwifAuthValue}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  {
    "NewWitnessOrVictim": {
      "ItemId": "{{Twiflm04VictimItemId}}",
      "PTIURN": {
        "Force": "{{TwifForce}}",
        "Unit": "{{TwifUnit}}",
        "Number": "{{TwifPTIURNNumber}}",
        "Year": "{{TwifYear}}"
      },
      "Person": {
        "UniqueId": "{{TwifVictimId}}",
        "Name": {
          "GivenName": "{{$randomLastName}}",
          "FamilyName": "{{$randomFirstName}}"
        },
        "ContactDetails": {
          "Address": {
            "AddressLine": [
              "{{$randomStreetName}}",
              "{{$randomCity}}"
            ],
            "Postcode": "NE1 1BB"
          },
          "ContactNumber": [
            {
              "Number": {
                "TelNationalNumber": "07900998844"
              },
              "TypeOfNumber": "mobile"
            },
            {
              "Number": {
                "TelNationalNumber": "01912587414"
              },
              "TypeOfNumber": "home"
            }
          ],
          "Email": "vic_wit_test@email.co.gov.uk"        
        },
        "TypeOfPerson": "VictimWitness",
        "DateOfBirth": "1970-08-03",
        "WitnessAndVictim": {
          "Witness": {
            "Occupation": "Civillian"
          },
          "Victim": {
            "dummy": "Head"
          }
        }
      }
    }
  }
}

script:pre-request {
  function generateFiveDigitNumber() {
      return Math.floor(10000 + Math.random() * 90000);
  }
  
  function generateSevenDigitNumber() {
      return Math.floor(1000000 + Math.random() * 9000000);
  }
  
  function generateElevenDigitNumber() {
      return Math.floor(10000000000 + Math.random() * 90000000000);
  }
  
  function generateUppercaseAlphaNumeric(length) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let result = '';
      for (let i = 0; i < length; i++) {
          result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return result;
  }
  
  let twiflm04VictimItemId = generateUppercaseAlphaNumeric(12);
  let twifVictimId = generateUppercaseAlphaNumeric(12);
  
  bru.setGlobalEnvVar("Twiflm04VictimItemId", twiflm04VictimItemId);
  bru.setGlobalEnvVar("TwifVictimId",twifVictimId );
  
  console.log("Twiflm04VictimItemId:", twiflm04VictimItemId);
  console.log("TwifVictimId:", twifVictimId);
  
  
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("TwifVictimCreateReqId",response.requestId);
}

settings {
  encodeUrl: true
  timeout: 0
}
