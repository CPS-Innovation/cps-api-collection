meta {
  name: 4. TWIF_LM04_WitnessId
  type: http
  seq: 4
}

post {
  url: {{CaseCreate_Url}}/api/twif/lm04
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateTwifAuthValue}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

body:json {
  {
    "NewWitnessOrVictim": {
      "ItemId": "{{Lm04WitnessItemId}}",
      "PTIURN": {
        "Force": "{{TwifForce}}",
        "Unit": "{{TwifUnit}}",
        "Number": "{{TwifPTIURNNumber}}",
        "Year": "{{TwifYear}}"
      },
      "Person": {
        "UniqueId": "{{TwifwitnessId}}",
        "Name": {
          "GivenName": "{{$randomLastName}}",
          "FamilyName": "{{$randomFirstName}}"
        },
        "ContactDetails": {
          "Address": {
            "AddressLine": [
              "{{$randomStreetName}}",
              "{{$randomCity}}"
            ],
            "Postcode": "NE1 1BB"
          },
          "ContactNumber": [
            {
              "Number": {
                "TelNationalNumber": "07900998844"
              },
              "TypeOfNumber": "mobile"
            },
            {
              "Number": {
                "TelNationalNumber": "01912587414"
              },
              "TypeOfNumber": "home"
            }
          ],
          "Email": "{{$randomEmail}}"
        },
        "PersonClassification": [
          {
            "ClassificationType": "StatusInformation",
            "ClassificationCode": "KeyWitness",
            "ClassificationValue": {
              "ClassificationValueText": "Yes"
            }
          }
        ],
        "TypeOfPerson": "Witness",
        "DateOfBirth": "1990-08-03",
        "Witness": {
          "Occupation": "Civillian"
        }
      }
    }
  }
}

script:pre-request {
  function generateFiveDigitNumber() {
      return Math.floor(10000 + Math.random() * 90000);
  }
  
  function generateSevenDigitNumber() {
      return Math.floor(1000000 + Math.random() * 9000000);
  }
  
  function generateElevenDigitNumber() {
      return Math.floor(10000000000 + Math.random() * 90000000000);
  }
  
  function generateUppercaseAlphaNumeric(length) {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let result = '';
      for (let i = 0; i < length; i++) {
          result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return result;
  }
  
  let lm04WitnessItemId = generateUppercaseAlphaNumeric(12);
  let twifwitnessId = generateUppercaseAlphaNumeric(12);
  
  bru.setGlobalEnvVar("Lm04WitnessItemId", lm04WitnessItemId);
  bru.setGlobalEnvVar("TwifwitnessId",twifwitnessId );
  
  
  
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("TwifWitnessCreateReqId",response.requestId);
}

settings {
  encodeUrl: true
  timeout: 0
}
