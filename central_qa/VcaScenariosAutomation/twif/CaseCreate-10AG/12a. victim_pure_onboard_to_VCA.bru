meta {
  name: 12a. victim_pure_onboard_to_VCA
  type: http
  seq: 15
}

post {
  url: {{StagingWmUrl}}/api/victims/urns/{{TwifCaseUrn}}/cases/{{TwifCaseId}}/parties/{{Twif_pureVictimPersonId}}
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingGetAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
  Token: {{StagingGetAuthToken}}
}

body:json {
  {
      "Urn": "{{TwifCaseUrn}}",
      "CreatedBy": "E2ETestAutomation",
      "Service": 1,
      "Onboarded": false
  }
}

script:post-response {
  const response = res.getBody();
  
  bru.setEnvVar("pureVictimGuid",response.value.victimCaseInfoGuid)
  
  console.log("pureVictimGuid:",bru.getEnvVar("pureVictimGuid")); 
}

settings {
  encodeUrl: true
  timeout: 0
}
