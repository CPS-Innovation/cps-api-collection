meta {
  name: UsersParty
  type: http
  seq: 1
}

get {
  url: {{StagingWmUrl}}/api/users/party
  body: json
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingGetAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

script:pre-request {
  
  
}

script:post-response {
  const response = res.getBody();
  
  bru.setGlobalEnvVar("partyId",response.partyId);
  bru.setGlobalEnvVar("partySurname",response.surname);
  bru.setGlobalEnvVar("partyFirstname",response.firstname);
}

settings {
  encodeUrl: true
  timeout: 0
}
