meta {
  name: ListWorkAssignment
  type: http
  seq: 30
}

get {
  url: {{StagingWmUrl}}/api/users/{{userId}}/areas/{{areaId}}/units/{{unitId}}/workassignmentteams
  body: formUrlEncoded
  auth: inherit
}

headers {
  Cms-Auth-Values: {{StagingDcfAuthValue}}
  x-functions-key: {{StagingWmKey}}
  User-Agent: Mozilla/4.0 (compatible; MSIE 7.0; Windows NT 10.0; WOW64; Trident/7.0; .NET4.0C; .NET4.0E; .NET CLR 2.0.50727; .NET CLR 3.0.30729; .NET CLR 3.5.30729; InfoPath.3)
}

vars:pre-request {
  userId: 2779760
}

script:pre-request {
  
  let areaId = 1527173;
  
  let unitId = 1527175;
  
  let userId = 1532532;
      
      
  bru.setGlobalEnvVar("areaId", areaId);
  
  bru.setGlobalEnvVar("unitId", unitId);
  
  bru.setGlobalEnvVar("userId", userId);
  
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
