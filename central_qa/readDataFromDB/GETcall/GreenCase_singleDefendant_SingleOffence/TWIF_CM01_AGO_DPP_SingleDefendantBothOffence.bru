              "ClassificationCode": "SuspectDecisionPriority",
              "ClassificationValue": {
                "ClassificationValueText": "{{TwifGreenCase}}"
              }
            }
          ],
          "ASN": {
            "Year": "{{TwifYear}}",
            "Force": "{{TwifForce}}",
            "Unit": "{{TwifUnit}}",
            "System": "00",
            "Number": "{{TwifASNNumber}}",
            "CheckCharacter": "W"
          },
          "ProposedCharge": [
            {
              "UniqueID": "{{TwifCaseOffenceId}}",
              "CJSCode": {
                "Code": {
                  "Alternative": {
                    "ActOrSource": "OS",
                    "Year": "89"
                  },
                  "Reason": "096"
                }
              },
              "Description": "Crime Text",
              "Category": "Summary Only",
              "FromDate": "2001-10-01",
              "Particulars": {
                "Address": {
                  "AddressLine": [
                    "{{$randomStreetName}}",
                    "{{$randomCity}}"
                  ],
                  "Postcode": "NE1 1BB",
                  "Country": "UK"
                }
              }
            },
                      {
              "UniqueID": "{{TwifCaseOffenceId2}}",
              "CJSCode": {
