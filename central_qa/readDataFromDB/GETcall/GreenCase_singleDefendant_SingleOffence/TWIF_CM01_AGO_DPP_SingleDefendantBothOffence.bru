                  "Alternative": {
                    "ActOrSource": "FS",
                    "Year": "23"
                  },
                  "Reason": "003"
                }
              },
              "Description": "Crime Text",
              "Category": "Summary Only",
              "FromDate": "2001-10-01",
              "Particulars": {
                "Address": {
                  "AddressLine": [
                    "{{$randomStreetName}}",
                    "{{$randomCity}}"
                  ],
                  "Postcode": "NE1 1BB",
                  "Country": "UK"
                }
              }
            }
          ]
        }
      ],
      "CaseOutlineItem": {
        "CaseOutlineHeading": {
          "ClassificationType": "CaseOutline",
          "ClassificationCode": "Heading",
