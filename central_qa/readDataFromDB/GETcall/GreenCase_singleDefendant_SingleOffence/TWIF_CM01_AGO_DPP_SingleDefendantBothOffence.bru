            "ClassificationValueText": "KEVD"
          }
        },
        "CaseOutlineText": "Text."
      },
      "PCDPoliceContactDetails": {
        "OfficerCompleting": {
          "UniqueId": "{{TwifSergeantPersonId}}",
          "Name": {
            "GivenName": "{{$randomLastName}}",
            "FamilyName": "{{$randomFirstName}}"
          },
