meta {
  name: DCF-CM01 - Single Suspect
  type: http
  seq: 2
}

post {
  url: {{CaseCreate_Url}}/api/dcf/cm01
  body: json
  auth: inherit
}

headers {
  X-Auth-Cookie: {{CaseCreateDcfAuthValue}}
}

body:json {
  {
    "PreChargeDecisionRequest": {
      "PTIURN": {
        "Force": {{DcfForce}},
        "Unit": "{{DcfUnit}}",
        "Number": "{{DCFPtiUrnNumber}}",
        "Year": "{{DcfYear}}"
      },
      "CPSUnit": {
        "TopLevel": "{{DcfToplevel}}",
        "SecondLevel": "{{DcfSecondlevel}}",
        "ThirdLevel": "{{DcfThirdlevel}}",
        "BottomLevel": "{{DcfBottomlevel}}",
        "LiteralValue": null
      },
      "OperationName": "Custody and Charging Officers",
      "CaseClassification": [
        {
          "ClassificationType": "Case Monitoring",
          "ClassificationCode": "Pre Charge Decision",
          "ClassificationValue": {
            "ClassificationValueFlag": true
          }
        },
              {
          "ClassificationType": "Case Monitoring",
          "ClassificationCode": "Not Guilty Anticipated Plea",
          "ClassificationValue": {
            "ClassificationValueFlag": true
          }
        }
      ],
      "FactualSummary": {
        "Paragraphs": [
          {
            "ItemHeading": {
              "ClassificationType": "Police Narrative",
              "ClassificationCode": "Factual Summary",
              "ClassificationValue": {
                "ClassificationValueText": "Summary of Circumstances of Offence(s)"
              }
            },
            "ItemText": "Narrative text for Summary of Circumstances of Offence(s)"
          }
        ]
      },
      "CITP": {
        "Paragraphs": [
          {
            "ItemHeading": {
              "ClassificationType": "Police Narrative",
              "ClassificationCode": "Confidential Information",
              "ClassificationValue": {
                "ClassificationValueText": "Reasonable Lines of Enquiry"
              }
            },
            "ItemText": "Narrative text for Reasonable Lines of Enquiry"
          }
        ]
      },
      "Suspect": [
        {
          "ReviewType": "Full Code Test",
          "PossibleOrProposedCharge": [
            {
              "Particulars": {
                "Address": {
                  "AddressLine": [
                    "{{$randomStreetName}}",
                    "{{$randomCity}}"
                  ],
                  "Postcode": "ZZ1 XX2",
                  "Country": "UK"
                }
              },
              "AnticipatedPlea": "Not Guilty",
              "UniqueID": "{{CaseOffenceId1}}",
              "CJSCode": {
                "Code": {
                  "Alternative": {
                    "ActOrSource": "DG",
                    "Year": "96"
                  },
                  "Reason": "001"
                }
              },
              "Description": "Poop",
              "Category": "Summary Only",
              "FromDate": "2019-02-10",
              "ToDate": "2019-03-01"
            },
            {
              "Particulars": {
                "Address": {
                  "AddressLine": [
                    "{{$randomStreetName}}",
                    "{{$randomCity}}"
                  ],
                  "Postcode": "ZZ1 XX2",
                  "Country": "UK"
                }
              },
              "AnticipatedPlea": "Not Guilty",
              "UniqueID": "{{CaseOffenceId2}}",
              "CJSCode": {
                "Code": {
                  "Alternative": {
                    "ActOrSource": "DD",
                    "Year": "95"
                  },
                  "Reason": "012"
                }
              },
              "Description": "Forging",
              "Category": "Either Way",
              "FromDate": "2019-02-10",
              "ToDate": "2019-03-01"
            },
            {
              "Particulars": {
                "Address": {
                  "AddressLine": [
                    "{{$randomStreetName}}",
                    "{{$randomCity}}"
                  ],
                  "Postcode": "ZZ1 XX2",
                  "Country": "UK"
                }
              },
              "AnticipatedPlea": "Not Guilty",
              "UniqueID": "{{CaseOffenceId3}}",
              "CJSCode": {
                "Code": {
                  "Alternative": {
                    "ActOrSource": "CJ",
                    "Year": "94"
                  },
                  "Reason": "002"
                }
              },
              "Description": "Assault",
              "Category": "Summary Only",
              "FromDate": "2019-02-10",
              "ToDate": "2019-03-01"
            }
          ],
          "Person": {
            "PolicePreChargeRemand": {
              "PolicePreChargeRemandStatus": "Released Under Investigation",
              "ProposedRemandAfterCharge": "Summons"
            },
            "UniqueId": "{{DefPersonId1}}",
            "Name": {
              "GivenName": "{{$randomLastName}}",
              "FamilyName": "{{$randomFirstName}}"
            },
            "ContactDetails": null,
            "PersonClassification": [
              {
                "ClassificationType": "StatusInformation",
                "ClassificationCode": "SuspectDecisionPriority",
                "ClassificationValue": {
                  "ClassificationValueText": "Green"
                }
              }
            ]
          },
          "ASN": {
            "Year": "{{DcfYear}}",
            "Force": "{{DcfForce}}",
            "Unit": "{{DcfUnit}}",
            "System": "00",
